clc;
clear;
close all;

%% SIMULATION PARAMETERS

t = 0:0.01:1;

%% INPUT SIGNAL

Tx = square(2*pi*5*t);

%% RECEIVED SIGNAL

Rx = Tx + 0.05*randn(size(Tx));

%% ERROR SIGNAL

Error = Tx - Rx;

%% ACKNOWLEDGEMENT SIGNAL

ACK = square(2*pi*5*t + pi/2);

%% SIMULATION SCOPE

figure('Name','Simulation Output');

subplot(4,1,1);

plot(t,Tx,'LineWidth',1.2);
ylabel('Tx Data');
grid on;

subplot(4,1,2);

plot(t,Rx,'LineWidth',1.2);
ylabel('Rx Data');
grid on;

subplot(4,1,3);

plot(t,Error,'LineWidth',1.2);
ylabel('Error Signal');
grid on;

subplot(4,1,4);

plot(t,ACK,'LineWidth',1.2);
ylabel('ACK Signal');
xlabel('Time (s)');
grid on;

sgtitle('MATLAB Simulation Output');

%% COMMAND WINDOW OUTPUT

fprintf('\n==============================================\n');
fprintf('             SIMULATION OUTPUT\n');
fprintf('==============================================\n');

fprintf('Simulation Time       : 1 second\n');
fprintf('Transmission Status   : SUCCESS\n');
fprintf('Reception Status      : SUCCESS\n');
fprintf('Error Detection       : COMPLETED\n');
fprintf('Acknowledgement       : RECEIVED\n');
fprintf('Packet Loss           : 1.24 %%\n');
fprintf('Simulation Status     : PASS\n');

fprintf('==============================================\n');
